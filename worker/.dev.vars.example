# Copiá este archivo como .dev.vars y completá los valores.
# .dev.vars está en .gitignore y nunca se sube.

# Marca el entorno local. El Worker desplegado usa el de wrangler.toml.
ENTORNO="dev"

# ── Supabase ───────────────────────────────────────────────────
# Project Settings → API Keys
SUPABASE_URL="https://hharoqxzmssmgvrkkkhd.supabase.co"

# La PUBLISHABLE key, la que empieza con sb_publishable_.
# Es pública a propósito: va escrita en el HTML del panel. Sola no
# sirve para nada — solo funciona con el JWT del usuario, y RLS lo
# encierra en su propio cliente.
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# La SECRET KEY, la que empieza con sb_secret_
# (Settings → API Keys → "Secret keys" → fila "default" → revelar y copiar)
#
# Este proyecto usa el esquema nuevo de claves de Supabase:
#   sb_publishable_...  reemplaza a la vieja anon key      → rol anon
#   sb_secret_...       reemplaza a la vieja service_role  → rol service_role
# La secret key bypassa RLS. Vive acá y en los secrets de Cloudflare,
# nunca en el navegador ni en git. La publishable NO sirve para el Worker.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# ── Anthropic ──────────────────────────────────────────────────
# console.anthropic.com → Settings → API keys → Create Key
# Ojo: la cuenta necesita crédito cargado o la API responde error de saldo.
ANTHROPIC_API_KEY="sk-ant-..."

# ── Pepper del hash de teléfono ────────────────────────────────
# Lo inventás vos, una sola vez. Es lo que hace que el hash del
# teléfono no se pueda revertir por fuerza bruta.
#
# En PowerShell:
#   -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
#
# NO se cambia nunca una vez que hay datos: los hashes viejos dejan de
# coincidir y las métricas de personas repetidas se parten al medio.
PEPPER_TELEFONO="pegar-aca"

# ── Google Calendar (cuenta de servicio) ───────────────────────
# OPCIONALES: sin estas dos el asistente funciona igual, pero no mira
# ni escribe en ningún calendario. Van las dos o ninguna.
#
# Salen del JSON que descargás al crear la clave de la cuenta de
# servicio en console.cloud.google.com.

# El campo "client_email" del JSON.
GOOGLE_SA_EMAIL="uptempo-agenda@tu-proyecto.iam.gserviceaccount.com"

# El campo "private_key" del JSON, COMPLETO y tal como viene: entre
# comillas dobles, con los \n escapados, desde -----BEGIN hasta -----END.
# Copialo del JSON sin reformatearlo.
GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
